{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fire-speak",
  "version": "0.1.0",
  "identifier": "jp.firemio.fire-speak",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "fire-speak",
        "width": 980,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "visible": true,
        "center": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "fire-speak overlay",
        "width": 380,
        "height": 110,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "closable": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
